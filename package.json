  "license": "MIT",
  "author": "Cacolet",
  "repository": "github:Cacolet/inkode",
  "packageManager": "pnpm@9.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/licenses.mjs && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "test": "vitest run",
    "licenses": "node scripts/licenses.mjs",
    "test:ui": "node tests/ui-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/lang-rust": "^6.0.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/common": "^1.2.0",
    "@pierre/diffs": "^1.4.0",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
